{
  "version": 1,
  "scoring": {
    "severity_weight": {
      "blocker": 5,
      "major": 3,
      "minor": 1
    },
    "status_value": {
      "pass": 1,
      "partial": 0.5,
      "fail": 0
    },
    "blocker_cap": 3,
    "global_blocker_cap": 5.9,
    "unknown_counts_as": "fail",
    "grades": [
      {
        "min": 9,
        "fr": "Excellent",
        "en": "Excellent"
      },
      {
        "min": 7.5,
        "fr": "Bon",
        "en": "Good"
      },
      {
        "min": 6,
        "fr": "Correct, à améliorer",
        "en": "Fair, needs work"
      },
      {
        "min": 4,
        "fr": "Insuffisant",
        "en": "Poor"
      },
      {
        "min": 0,
        "fr": "Critique",
        "en": "Critical"
      }
    ]
  },
  "thresholds": {
    "_note": "Defaults; override any of them in .motion/project.json \"thresholds\". dead_air_s, motion_floor, freeze_s, still_per_30s_max, flashes_per_s and the loudness values were checked on 15 reference films scored 7 to 8 by an AI jury, with zero false alarm (docs/CALIBRATION.md). still_per_30s_max follows the frozen-time budget of echris6/motion-video-kit (28 launch films). sync_tolerance_ms is about one frame at 24 to 30 fps. The VMAF, caption and web values are conventions.",
    "loudness_lufs": -14,
    "loudness_tolerance_lu": 1,
    "true_peak_dbtp": -1,
    "freeze_s": 1,
    "hero_min_px": 170,
    "dead_air_s": 3,
    "motion_floor": 0.4,
    "flashes_per_s": 3,
    "flash_delta": 0.1,
    "duration_tolerance": 0.1,
    "vmaf_min": 93,
    "caption_offset_ms": 100,
    "caption_cps_max": 17,
    "caption_coverage_min": 0.98,
    "caption_lines_max": 2,
    "text_min_s": 1.2,
    "text_words_per_s": 3,
    "web_smooth_frames_min": 0.95,
    "web_cls_max": 0.1,
    "hardcoded_motion_max": 3,
    "ai_tells_max": 0,
    "fonts_max": 2,
    "black_frames_max_s": 0.1,
    "silence_edge_max_s": 0.5,
    "still_per_30s_max": 1,
    "end_card_s": 2,
    "sync_tolerance_ms": 45
  },
